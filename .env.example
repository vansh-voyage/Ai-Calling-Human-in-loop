# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./frontdesk.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# How long before an unanswered help request is marked "unresolved"
REQUEST_TIMEOUT_HOURS=24

# Optional: POST supervisor alert JSON here (e.g. Slack incoming webhook URL)
SUPERVISOR_WEBHOOK_URL=

# Optional: POST simulated SMS JSON here
SMS_WEBHOOK_URL=

# CORS: allow the React dev server
ALLOWED_ORIGINS=http://localhost:5173

# ── Agent ─────────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LLM (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# STT
DEEPGRAM_API_KEY=

# TTS
CARTESIA_API_KEY=

# Backend URL the agent calls for KB lookup and escalation
BACKEND_API_URL=http://localhost:8000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
